# OmOMeow Gateway Configuration Template
# Copy this file to .env or use as template for OmOMeow (오모냥) deployment.
# Never commit real tokens or credentials into source control.

# ==============================================================================
# Discord Credentials & Multi-Bot Configuration
# ==============================================================================
# Primary Discord Bot Token (migrated from agent-messenger credential store:
# ~/.config/agent-messenger/discordbot-credentials.json -> OmOMeow bot)
DISCORD_BOT_TOKENS=<OMOMEOW_DISCORD_TOKEN>

# Bot Snowflake ID for OmOMeow (오모냥)
DISCORD_BOT_ID=1465631383862120451

# Discord channel / user permissions
# DISCORD_ALLOWED_USERS=414011632306618368
# DISCORD_HOME_CHANNEL=1529738911377657967
# DISCORD_FREE_RESPONSE_CHANNELS=1529738911377657967
DISCORD_AUTO_THREAD=true
DISCORD_THREAD_SESSIONS_PER_USER=true

# ==============================================================================
# Model & Agent Backend
# ==============================================================================
# Model selection: DeepSeek V4.1 Flash via inferhub
OMON_DEFAULT_MODEL=inferhub/cb/deepseek-v4.1-flash
DEFAULT_MODEL=inferhub/cb/deepseek-v4.1-flash

# Backend mode: omo daemon vs llm direct
OMON_AGENT_BACKEND=omo
OMON_OMO_APPSERVER_URL=ws://127.0.0.1:19742
OMON_OMO_CRON_APPSERVER_URL=ws://127.0.0.1:19742

# Isolated workspace directory per agent / bot profile
OMON_PER_AGENT_WORKSPACE=true

# ==============================================================================
# Approval Policy & Security
# ==============================================================================
# Automatic approval policy for OmOMeow autonomous execution
APPROVAL_POLICY=auto
APPROVAL_MODE=auto

# Seconds to wait for Discord approval interaction before expiry
APPROVAL_TIMEOUT_SECS=900

# ==============================================================================
# Lane Ports, Timeouts & Actions
# ==============================================================================
# Button action configuration mapping
OMON_BUTTON_ACTIONS_FILE=~/.omon/button-actions.json

# Web dashboard port
DASHBOARD_PORT=9119

# Interactive & cron turn timeouts (in seconds)
OMON_OMO_TURN_TIMEOUT_SECS=1800
OMON_OMO_TURN_TOTAL_TIMEOUT_SECS=1800
OMON_OMO_CRON_TURN_TOTAL_TIMEOUT_SECS=600
OMON_CRON_SCRIPT_TIMEOUT_SECS=1800
