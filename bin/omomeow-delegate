#!/usr/bin/env bash
# The checkout preserves this script's executable mode in git; keep it runnable
# when a worktree materializes tracked files without executable permissions.
set -euo pipefail

usage() {
    cat <<'EOF'
Usage:
  omomeow-delegate --title <TITLE> --repo <REPO> --brief <BRIEF> [OPTIONS]
  omomeow-delegate <TITLE> <REPO> <BRIEF>

Options:
  --title <TITLE>        Title / description of the work item (Required)
  --repo <REPO>          Target repository path or name (Required)
  --brief <BRIEF>        Detailed task brief / instructions (Required)
  --done <SIGNAL>        Machine-checkable completion signal
  --thread-id <ID>       Discord or parent thread ID (optional, default: $THREAD_ID or $DISCORD_THREAD_ID)
  --db <PATH>            Path to SQLite database file or sqlite:// URI (default: $DATABASE_URL or omon_gateway.db)
  --cwd <PATH>           Working directory for created tab/workspace
  -h, --help             Show this help message
EOF
    exit "${1:-0}"
}

TITLE=""
REPO=""
BRIEF=""
THREAD_ID="${THREAD_ID:-${DISCORD_THREAD_ID:-}}"
DB_TARGET="${DATABASE_URL:-omon_gateway.db}"
CUSTOM_CWD=""
DONE_SIGNAL=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --title)
            TITLE="$2"
            shift 2
            ;;
        --repo)
            REPO="$2"
            shift 2
            ;;
        --brief)
            BRIEF="$2"
            shift 2
            ;;
        --done)
            DONE_SIGNAL="$2"
            shift 2
            ;;
        --thread-id)
            THREAD_ID="$2"
            shift 2
            ;;
        --db)
            DB_TARGET="$2"
            shift 2
            ;;
        --cwd)
            CUSTOM_CWD="$2"
            shift 2
            ;;
        -h|--help)
            usage 0
            ;;
        -*)
            echo "Unknown option: $1" >&2
            usage 1
            ;;
        *)
            if [[ -z "$TITLE" ]]; then
                TITLE="$1"
            elif [[ -z "$REPO" ]]; then
                REPO="$1"
            elif [[ -z "$BRIEF" ]]; then
                BRIEF="$1"
            else
                echo "Unexpected positional argument: $1" >&2
                usage 1
            fi
            shift
            ;;
    esac
done

if [[ -z "$TITLE" || -z "$REPO" || -z "$BRIEF" ]]; then
    echo "Error: --title, --repo, and --brief are required." >&2
    usage 1
fi

TARGET_CWD="${CUSTOM_CWD:-$REPO}"
if [[ -z "$DONE_SIGNAL" ]]; then
    JSON_CWD=$(printf '%s' "$TARGET_CWD" | sed 's/\\/\\\\/g; s/"/\\"/g')
    DONE_SIGNAL="command [\"git\",\"-C\",\"${JSON_CWD}\",\"diff\",\"--quiet\"]"
    echo "Warning: defaulting to a git diff signal; a real completion signal is better." >&2
fi

SLUG=$(printf '%s' "$TITLE" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//' | cut -c 1-40)
SLUG=${SLUG%-}
[[ -n "$SLUG" ]] || SLUG="task"
RANDOM_HEX=$(od -An -N2 -tx1 /dev/urandom | tr -d ' \n')
LANE_KEY="${SLUG}-${RANDOM_HEX}"
BRIEF_PATH="${HOME}/.omon/state/lanes/${LANE_KEY}/brief.md"
mkdir -p "$(dirname "$BRIEF_PATH")"
printf '%s' "$BRIEF" > "$BRIEF_PATH"

GATEWAY_BIN="${OMO_GATEWAY_BIN:-omo-gateway}"
GATEWAY_ARGS=(lane start "$LANE_KEY" --title "$TITLE" --brief "$BRIEF_PATH" --done "$DONE_SIGNAL")
[[ -n "$THREAD_ID" ]] && GATEWAY_ARGS+=(--thread "$THREAD_ID")
GATEWAY_ARGS+=(--cwd "$TARGET_CWD")
exec env DATABASE_URL="$DB_TARGET" "$GATEWAY_BIN" "${GATEWAY_ARGS[@]}"
