+describe("host enumeration verdict reuse", () => {
+  test.each(["legacy", "shard"] as const)("negative %s RPC verdict avoids all requests and retains responsive peers", async (target) => {
+    const dir = tempDir("thr-tui-")
+    const legacy = join(dir, "rpc.sock")
+    const shard = join(dir, "i-0123456789abcdef.sock")
+    const tui = join(dir, "t-0123456789abcdef.sock")
+    const unavailable = target === "legacy" ? legacy : shard
+    const responsive = target === "legacy" ? shard : legacy
+    const sessionPath = join(dir, "offline.jsonl")
+    writeFileSync(sessionPath, `${JSON.stringify({ type: "session", version: 3, id: "dur-offline", timestamp: "2026-09-28T04:19:00.000Z", cwd: process.cwd() })}\n`)
+    const stopped = await hostEndpoint(unavailable)
+    const host = await hostEndpoint(responsive)
+    const terminal = await tuiEndpoint(tui, { id: "dur-tui", path: join(dir, "tui.jsonl"), name: "terminal" })
+    const w = surfaceFor(legacy, [
+      { socket: unavailable, reachable: false, session_paths: [sessionPath], endpoint_kind: "rpc_host", alive: false, reason: "live_unresponsive" },
+      { socket: responsive, reachable: true, session_paths: [], endpoint_kind: "rpc_host", alive: true, reason: null },
+      { socket: tui, reachable: true, session_paths: [], endpoint_kind: "tui", alive: true, reason: null },
+    ])
+
+    const threads = threadsOf(await w.run("thread_list", { all_scope: true }))
+
+    expect(threads.find((thread) => thread.thread_id === "dur-offline")).toMatchObject({ status: "resumable", alive: false, error_note: "live_unresponsive" })
+    expect(threads.find((thread) => thread.thread_id === "dur-host")).toMatchObject({ status: "live", alive: true })
+    expect(threads.find((thread) => thread.thread_id === "dur-tui")).toMatchObject({ status: "live", alive: true, surface: "tui" })
+    expect(stopped.frames).toEqual([])
+    expect(w.dialed).not.toContain(unavailable)
+    expect(host.frames.filter((frame) => frame.type === "list_sessions")).toHaveLength(1)
+    expect(terminal.frames.filter((frame) => frame.type === "list_sessions")).toHaveLength(1)
+  })
+
+  test("an unknown RPC verdict still lists a reachable host even if reachable was false", async () => {
+    const dir = tempDir("thr-tui-")
+    const legacy = join(dir, "rpc.sock")
+    const host = await hostEndpoint(legacy)
+    const w = surfaceFor(legacy, [{ socket: legacy, reachable: false, session_paths: [], endpoint_kind: "rpc_host" }])
+
+    expect(threadsOf(await w.run("thread_list", { all_scope: true }))).toMatchObject([{ thread_id: "dur-host", status: "live" }])
+    expect(w.dialed).toEqual([legacy])
+    expect(host.frames).toEqual([{ id: expect.any(String), type: "list_sessions", observe: true }])
+  })
+
+  test.each(["dead", "live_unresponsive"] as const)("all-unavailable %s verdicts retain failures and offline host rows without requests", async (reason) => {
+    const dir = tempDir("thr-tui-")
+    const legacy = join(dir, "rpc.sock")
+    const shard = join(dir, "i-0123456789abcdef.sock")
+    const legacyHost = await hostEndpoint(legacy)
+    const shardHost = await hostEndpoint(shard)
