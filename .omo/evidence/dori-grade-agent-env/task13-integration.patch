+        tokio::time::timeout(Duration::from_secs(5), task)
+            .await
+            .unwrap()
+            .unwrap()
+            .unwrap();
+    }
+
+    async fn status(&self) -> Lane {
+        get_lane(self.db.pool(), &self.lane.key)
+            .await
+            .unwrap()
+            .unwrap()
+    }
