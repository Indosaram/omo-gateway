@@ -0,0 +1,163 @@
+import type { Cycle, Issue, Priority, StateType, User, WorkflowState } from './types'
+import { PRIORITY_LABELS } from './types'
+
+const DAY = 86_400_000
+
+function startOfDay(date: Date): Date {
+  const copy = new Date(date)
+  copy.setHours(0, 0, 0, 0)
+  return copy
+}
+
+export function parseDateOnly(value: string): Date {
+  const [y, m, d] = value.split('-').map(Number)
+  return new Date(y, (m ?? 1) - 1, d ?? 1)
+}
+
+export function toDateOnly(date: Date): string {
+  const y = date.getFullYear()
+  const m = String(date.getMonth() + 1).padStart(2, '0')
+  const d = String(date.getDate()).padStart(2, '0')
+  return `${y}-${m}-${d}`
+}
+
+export function shortDate(value: string | null | undefined): string {
+  if (!value) return ''
+  const date = value.length === 10 ? parseDateOnly(value) : new Date(value)
+  const now = new Date()
+  const opts: Intl.DateTimeFormatOptions =
+    date.getFullYear() === now.getFullYear() ? { month: 'short', day: 'numeric' } : { month: 'short', day: 'numeric', year: 'numeric' }
+  return date.toLocaleDateString('en-US', opts)
+}
+
+export function fullDate(value: string | null | undefined): string {
+  if (!value) return ''
+  const date = new Date(value)
+  return date.toLocaleString('en-US', {
+    month: 'short',
+    day: 'numeric',
+    year: 'numeric',
+    hour: 'numeric',
+    minute: '2-digit',
+  })
+}
+
+export function relativeTime(value: string | null | undefined, now = Date.now()): string {
+  if (!value) return ''
+  const diff = now - new Date(value).getTime()
+  const abs = Math.abs(diff)
+  const suffix = diff >= 0 ? 'ago' : 'from now'
+  if (abs < 60_000) return 'just now'
+  if (abs < 3_600_000) return `${Math.round(abs / 60_000)} min ${suffix}`
+  if (abs < DAY) {
+    const h = Math.round(abs / 3_600_000)
+    return `${h} ${h === 1 ? 'hour' : 'hours'} ${suffix}`
+  }
+  if (abs < 30 * DAY) {
+    const d = Math.round(abs / DAY)
+    return `${d} ${d === 1 ? 'day' : 'days'} ${suffix}`
+  }
+  if (abs < 365 * DAY) {
+    const mo = Math.round(abs / (30 * DAY))
+    return `${mo} ${mo === 1 ? 'month' : 'months'} ${suffix}`
+  }
+  const y = Math.round(abs / (365 * DAY))
+  return `${y} ${y === 1 ? 'year' : 'years'} ${suffix}`
+}
+
+export function compactRelative(value: string | null | undefined, now = Date.now()): string {
+  if (!value) return ''
+  const abs = Math.abs(now - new Date(value).getTime())
+  if (abs < 3_600_000) return `${Math.max(1, Math.round(abs / 60_000))}m`
+  if (abs < DAY) return `${Math.round(abs / 3_600_000)}h`
+  if (abs < 30 * DAY) return `${Math.round(abs / DAY)}d`
+  if (abs < 365 * DAY) return `${Math.round(abs / (30 * DAY))}mo`
+  return `${Math.round(abs / (365 * DAY))}y`
+}
+
+export type DueState = 'overdue' | 'soon' | 'later' | null
+
+export function dueState(due: string | null, completed: boolean): DueState {
+  if (!due || completed) return null
+  const today = startOfDay(new Date()).getTime()
+  const target = parseDateOnly(due).getTime()
+  if (target < today) return 'overdue'
+  if (target - today <= 2 * DAY) return 'soon'
+  return 'later'
+}
+
+export function dueShortcuts(now = new Date()): { id: string; label: string; date: string }[] {
+  const today = startOfDay(now)
+  const add = (days: number) => toDateOnly(new Date(today.getTime() + days * DAY))
+  const endOfWeek = 5 - today.getDay()
+  return [
+    { id: 'today', label: 'Today', date: add(0) },
+    { id: 'tomorrow', label: 'Tomorrow', date: add(1) },
+    { id: 'eow', label: 'End of this week', date: add(endOfWeek >= 0 ? endOfWeek : endOfWeek + 7) },
+    { id: 'week', label: 'In one week', date: add(7) },
+    { id: 'two-weeks', label: 'In two weeks', date: add(14) },
+    { id: 'month', label: 'In one month', date: add(30) },
+  ]
+}
+
+export function priorityLabel(priority: Priority): string {
+  return PRIORITY_LABELS[priority]
+}
+
+export function stateProgress(state: WorkflowState, teamStates: WorkflowState[]): number {
+  if (state.type === 'completed') return 1
+  if (state.type !== 'started') return 0
+  const started = teamStates.filter((s) => s.type === 'started').sort((a, b) => a.position - b.position)
+  const index = started.findIndex((s) => s.id === state.id)
+  return started.length === 0 ? 0.5 : (index + 1) / (started.length + 1)
+}
+
+export function isClosedType(type: StateType): boolean {
+  return type === 'completed' || type === 'canceled'
+}
+
+export function branchName(issue: Issue, me: User | null): string {
+  const slug = issue.title
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '')
+    .slice(0, 48)
+  const owner = (me?.display_name || me?.name || 'me').toLowerCase().replace(/[^a-z0-9]+/g, '')
+  return `${owner}/${issue.identifier.toLowerCase()}-${slug}`
+}
+
+export function cycleLabel(cycle: Cycle): string {
+  return cycle.name?.trim() ? cycle.name : `Cycle ${cycle.number}`
+}
+
+export function cycleStatus(cycle: Cycle, now = Date.now()): 'past' | 'current' | 'upcoming' {
+  if (cycle.completed_at || new Date(cycle.ends_at).getTime() < now) return 'past'
+  if (new Date(cycle.starts_at).getTime() <= now) return 'current'
+  return 'upcoming'
+}
+
+export function cycleProgressRatio(cycle: Cycle, now = Date.now()): number {
+  const start = new Date(cycle.starts_at).getTime()
+  const end = new Date(cycle.ends_at).getTime()
+  if (end <= start) return 0
+  return Math.min(1, Math.max(0, (now - start) / (end - start)))
+}
+
+export function initials(name: string): string {
+  const parts = name.trim().split(/\s+/).filter(Boolean)
+  if (parts.length === 0) return '?'
+  if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase()
+  return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase()
+}
+
+export function pluralize(count: number, singular: string, plural = `${singular}s`): string {
+  return `${count} ${count === 1 ? singular : plural}`
+}
+
+export function isMac(): boolean {
+  return typeof navigator !== 'undefined' && /Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent)
+}
+
+export function modKey(): string {
+  return isMac() ? '⌘' : 'Ctrl'
+}
diff --git a/web/src/tracker/hotkeys.ts b/web/src/tracker/hotkeys.ts
new file mode 100644
index 0000000..ff404df
--- /dev/null
+++ b/web/src/tracker/hotkeys.ts
@@ -0,0 +1,170 @@
+import { useEffect, useRef } from 'react'
+
+export interface HotkeyOptions {
+  enabled?: boolean
+  allowInInputs?: boolean
+  preventDefault?: boolean
+  scope?: string
+}
+
+interface Binding {
+  combo: ParsedCombo
+  handler: (event: KeyboardEvent) => void
+  opts: HotkeyOptions
+  order: number
+}
+
+interface ParsedCombo {
+  key: string
+  mod: boolean
+  shift: boolean
+  alt: boolean
+}
+
+const bindings = new Set<Binding>()
+const sequences = new Set<{ keys: string[]; handler: () => void; opts: HotkeyOptions; order: number }>()
+let installed = false
+let counter = 0
+let buffer: string[] = []
+let bufferTimer: number | undefined
+const scopeStack: string[] = []
+
+export function pushHotkeyScope(scope: string): () => void {
+  scopeStack.push(scope)
+  return () => {
+    const index = scopeStack.lastIndexOf(scope)
+    if (index >= 0) scopeStack.splice(index, 1)
+  }
+}
+
+export function activeHotkeyScope(): string | null {
+  return scopeStack.length ? scopeStack[scopeStack.length - 1] : null
+}
+
+function parseCombo(combo: string): ParsedCombo {
+  const parts = combo.toLowerCase().split('+').map((p) => p.trim())
+  const key = parts[parts.length - 1]
+  return {
+    key: key === 'space' ? ' ' : key,
+    mod: parts.includes('mod') || parts.includes('cmd') || parts.includes('ctrl'),
+    shift: parts.includes('shift'),
+    alt: parts.includes('alt') || parts.includes('option'),
+  }
+}
+
+function eventKey(event: KeyboardEvent): string {
+  if (event.key === ' ' || event.code === 'Space') return ' '
+  if (event.code?.startsWith('Key') && event.code.length === 4) return event.code.slice(3).toLowerCase()
+  if (event.code?.startsWith('Digit')) return event.code.slice(5)
+  return event.key.toLowerCase()
+}
+
+export function isEditableTarget(target: EventTarget | null): boolean {
+  if (!(target instanceof HTMLElement)) return false
+  if (target.isContentEditable) return true
+  const tag = target.tagName
+  return tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT'
+}
+
+function matches(combo: ParsedCombo, event: KeyboardEvent): boolean {
+  const key = eventKey(event)
+  const mod = event.metaKey || event.ctrlKey
+  if (combo.key === '?') {
+    return event.key === '?' && mod === combo.mod
+  }
+  return key === combo.key && mod === combo.mod && event.shiftKey === combo.shift && event.altKey === combo.alt
+}
+
+function scopeAllows(opts: HotkeyOptions): boolean {
+  const active = activeHotkeyScope()
+  if (!active) return !opts.scope || opts.scope === 'global'
+  return opts.scope === active
+}
+
+function onKeyDown(event: KeyboardEvent) {
+  if (event.defaultPrevented) return
+  const editable = isEditableTarget(event.target)
+  const ordered = [...bindings].sort((a, b) => b.order - a.order)
+  for (const binding of ordered) {
+    if (binding.opts.enabled === false) continue
+    if (editable && !binding.opts.allowInInputs) continue
+    if (!scopeAllows(binding.opts)) continue
+    if (matches(binding.combo, event)) {
+      if (binding.opts.preventDefault !== false) event.preventDefault()
+      binding.handler(event)
+      buffer = []
+      return
+    }
+  }
+  if (editable || event.metaKey || event.ctrlKey || event.altKey) return
+  const key = eventKey(event)
+  if (key.length !== 1) return
+  buffer.push(key)
+  window.clearTimeout(bufferTimer)
+  bufferTimer = window.setTimeout(() => {
+    buffer = []
+  }, 900)
+  const orderedSeq = [...sequences].sort((a, b) => b.order - a.order)
+  for (const seq of orderedSeq) {
+    if (seq.opts.enabled === false || !scopeAllows(seq.opts)) continue
+    const tail = buffer.slice(-seq.keys.length)
+    if (tail.length === seq.keys.length && tail.every((k, i) => k === seq.keys[i])) {
+      event.preventDefault()
+      buffer = []
+      seq.handler()
+      return
+    }
+  }
+}
+
+function install() {
+  if (installed) return
+  installed = true
+  window.addEventListener('keydown', onKeyDown)
+}
+
+export function useHotkey(combo: string | string[], handler: (event: KeyboardEvent) => void, opts: HotkeyOptions = {}) {
+  const handlerRef = useRef(handler)
+  handlerRef.current = handler
+  const combos = Array.isArray(combo) ? combo : [combo]
+  const key = combos.join('|')
+  const { enabled, allowInInputs, preventDefault, scope } = opts
+  useEffect(() => {
+    install()
+    const created = key.split('|').map((c) => ({
+      combo: parseCombo(c),
+      handler: (event: KeyboardEvent) => handlerRef.current(event),
+      opts: { enabled, allowInInputs, preventDefault, scope },
+      order: ++counter,
+    }))
+    created.forEach((b) => bindings.add(b))
+    return () => created.forEach((b) => bindings.delete(b))
+  }, [key, enabled, allowInInputs, preventDefault, scope])
+}
+
+export function useSequence(keys: string[], handler: () => void, opts: HotkeyOptions = {}) {
+  const handlerRef = useRef(handler)
+  handlerRef.current = handler
+  const signature = keys.join(' ')
+  const { enabled, scope } = opts
+  useEffect(() => {
+    install()
+    const entry = {
+      keys: signature.split(' '),
+      handler: () => handlerRef.current(),
+      opts: { enabled, scope },
+      order: ++counter,
+    }
+    sequences.add(entry)
+    return () => {
+      sequences.delete(entry)
+    }
+  }, [signature, enabled, scope])
+}
+
+export function useHotkeyScope(scope: string, active: boolean) {
+  useEffect(() => {
+    if (!active) return
+    return pushHotkeyScope(scope)
+  }, [scope, active])
+}
