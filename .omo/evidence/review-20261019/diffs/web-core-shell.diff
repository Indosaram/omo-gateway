+
+export type Theme = 'dark' | 'light'
+
+export interface CreateDraft extends Partial<IssueCreate> {
+  team_id?: ID
+}
+
+export interface TrackerState {
+  ready: boolean
+  error: string | null
+  me: User | null
+  users: User[]
+  teams: Team[]
