+    #[tokio::test]
+    async fn owner_dm_key_is_the_persisted_owner_dm() {
+        let pool = pool().await;
+        let api = SlackApi::with_base_url("xoxb-test".into(), fake_open_im().await);
+        let config = SlackConfig {
+            allowed_users: vec!["UOWNER".into()],
+            ..SlackConfig::test_default()
+        };
+        let key = owner_dm_key(&api, &config, "UBOT", &pool).await.unwrap();
+        assert_eq!(key.platform, PLATFORM);
+        assert_eq!(key.guild_id, None);
+        assert_eq!(key.thread_id, None);
+        assert_eq!(key.channel_id, "DOWNER");
+        assert_eq!(key.user_id, "UOWNER");
+        assert_eq!(key.bot_id.as_deref(), Some("UBOT"));
+        let stored: (String, String) = sqlx::query_as(
+            "SELECT platform, user_id FROM sessions WHERE session_key = ? AND guild_id IS NULL AND thread_id IS NULL",
+        )
+        .bind(key.storage_key())
+        .fetch_one(&pool)
+        .await
+        .unwrap();
+        assert_eq!(stored, ("slack".into(), "UOWNER".into()));
+        let again = owner_dm_key(&api, &config, "UBOT", &pool).await.unwrap();
+        assert_eq!(again.storage_key(), key.storage_key());
+        assert_eq!(
+            key.storage_key()
+                .parse::<SessionKey>()
+                .unwrap()
+                .storage_key(),
+            key.storage_key()
+        );
+    }
+
+    #[test]
+    fn home_follows_explicit_platform_then_discord_presence() {
+        assert!(is_home(Some("slack"), true));
+        assert!(is_home(Some(" Slack "), true));
+        assert!(!is_home(Some("discord"), true));
+        assert!(is_home(Some("discord"), false));
+        assert!(!is_home(None, true));
+        assert!(is_home(None, false));
+    }
+
+    #[tokio::test]
+    async fn persona_copies_once_and_never_overwrites() {
+        let pool = pool().await;
+        sqlx::query(
+            "INSERT INTO bot_profiles (bot_id, name, model, system_prompt, enabled_toolsets) VALUES ('SRC', 'wawabot', 'm', 'persona', 'web')",
+        )
+        .execute(&pool)
+        .await
+        .unwrap();
+        assert!(copy_persona(&pool, "SRC", "UBOT").await.unwrap());
+        let copied: (String, String) =
+            sqlx::query_as("SELECT name, system_prompt FROM bot_profiles WHERE bot_id = 'UBOT'")
+                .fetch_one(&pool)
+                .await
+                .unwrap();
+        assert_eq!(copied, ("wawabot".into(), "persona".into()));
+        sqlx::query("UPDATE bot_profiles SET system_prompt = 'edited' WHERE bot_id = 'UBOT'")
+            .execute(&pool)
+            .await
+            .unwrap();
+        assert!(!copy_persona(&pool, "SRC", "UBOT").await.unwrap());
+        let kept: String =
+            sqlx::query_scalar("SELECT system_prompt FROM bot_profiles WHERE bot_id = 'UBOT'")
+                .fetch_one(&pool)
+                .await
+                .unwrap();
+        assert_eq!(kept, "edited");
+        assert!(!copy_persona(&pool, "MISSING", "UOTHER").await.unwrap());
+    }
+
+    #[test]
+    fn persona_source_defaults_to_wawabot() {
+        assert_eq!(persona_source(None), DEFAULT_PERSONA_SOURCE);
+        assert_eq!(persona_source(Some("  ")), DEFAULT_PERSONA_SOURCE);
+        assert_eq!(persona_source(Some(" X ")), "X");
+    }
+}
diff --git a/src/slack/lifecycle.rs b/src/slack/lifecycle.rs
new file mode 100644
index 0000000..829999b
--- /dev/null
+++ b/src/slack/lifecycle.rs
@@ -0,0 +1,292 @@
+//! Slack conversation lifecycle: archiving or deleting a channel, or deleting a thread root,
+//! stops the affected turns and updates session state with the same SQL as Discord's
+//! `handle_thread_update` / `handle_thread_delete`.
+
+use serde_json::Value;
+use sqlx::SqlitePool;
+
+use super::PLATFORM;
+use crate::{Result, SessionKey, SessionMultiplexer};
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum Lifecycle {
+    Archived { channel: String, archived: bool },
+    ChannelDeleted { channel: String },
+    ThreadRootDeleted { channel: String, thread_ts: String },
+}
+
+pub fn classify(event: &Value) -> Option<Lifecycle> {
+    let field = |name: &str| event.get(name).and_then(Value::as_str).map(str::to_owned);
+    match field("type")?.as_str() {
+        "channel_archive" | "group_archive" => Some(Lifecycle::Archived {
+            channel: field("channel")?,
+            archived: true,
+        }),
+        "channel_unarchive" | "group_unarchive" => Some(Lifecycle::Archived {
+            channel: field("channel")?,
+            archived: false,
+        }),
+        "channel_deleted" | "group_deleted" => Some(Lifecycle::ChannelDeleted {
+            channel: field("channel")?,
+        }),
+        "message" if field("subtype").as_deref() == Some("message_deleted") => {
+            Some(Lifecycle::ThreadRootDeleted {
+                channel: field("channel")?,
+                thread_ts: field("deleted_ts")?,
+            })
+        }
+        _ => None,
+    }
+}
+
+/// `Ok(true)` when the event was a lifecycle event (handled or not relevant to any session);
+/// such events never reach message routing.
+pub async fn handle(
+    multiplexer: &SessionMultiplexer,
+    pool: &SqlitePool,
+    bot_user_id: &str,
+    event: &Value,
+) -> Result<bool> {
+    let Some(lifecycle) = classify(event) else {
+        return Ok(false);
+    };
+    match lifecycle {
+        Lifecycle::Archived { channel, archived } => {
+            for key in sessions(pool, bot_user_id, &channel, None).await? {
+                if archived {
+                    stop(multiplexer, &key, "archived").await;
+                }
+                if let Err(error) = sqlx::query(
+                    "UPDATE sessions SET state_json = json_set(COALESCE(state_json, '{}'), '$.metadata.thread_archived', json(?)) WHERE session_key = ?",
+                )
+                .bind(if archived { "true" } else { "false" })
+                .bind(key.storage_key())
+                .execute(pool)
+                .await
+                {
+                    tracing::warn!(session = %key, %error, "failed to persist Slack archived state");
+                }
+            }
+        }
+        Lifecycle::ChannelDeleted { channel } => {
+            for key in sessions(pool, bot_user_id, &channel, None).await? {
+                clear_binding(multiplexer, pool, &key).await;
+            }
+        }
+        Lifecycle::ThreadRootDeleted { channel, thread_ts } => {
+            for key in sessions(pool, bot_user_id, &channel, Some(&thread_ts)).await? {
+                clear_binding(multiplexer, pool, &key).await;
+            }
+        }
+    }
+    Ok(true)
+}
+
+async fn stop(multiplexer: &SessionMultiplexer, key: &SessionKey, why: &str) {
+    if let Err(error) = multiplexer.stop(key).await {
+        tracing::warn!(session = %key, %error, why, "failed to stop Slack turn");
+    }
+}
+
+async fn clear_binding(multiplexer: &SessionMultiplexer, pool: &SqlitePool, key: &SessionKey) {
+    stop(multiplexer, key, "deleted").await;
+    if let Err(error) = sqlx::query(
+        "UPDATE sessions SET state_json = json_remove(COALESCE(state_json, '{}'), '$.metadata.omo_thread_id') WHERE session_key = ?",
+    )
+    .bind(key.storage_key())
+    .execute(pool)
+    .await
+    {
+        tracing::warn!(session = %key, %error, "failed to clear deleted Slack thread binding");
+    }
+}
+
+/// Sessions of this bot in `channel`; only the thread `thread_ts` when given.
+async fn sessions(
+    pool: &SqlitePool,
+    bot_user_id: &str,
+    channel: &str,
+    thread_ts: Option<&str>,
+) -> Result<Vec<SessionKey>> {
+    let rows: Vec<String> = sqlx::query_scalar(
+        "SELECT session_key FROM sessions WHERE platform = ? AND channel_id = ? AND (? IS NULL OR thread_id = ?)",
+    )
+    .bind(PLATFORM)
+    .bind(channel)
+    .bind(thread_ts)
+    .bind(thread_ts)
+    .fetch_all(pool)
+    .await?;
+    Ok(rows
+        .iter()
+        .filter_map(|raw| SessionKey::from_storage_key(raw).ok())
+        .filter(|key| key.bot_id.as_deref() == Some(bot_user_id))
+        .collect())
+}
+
+#[cfg(test)]
+mod tests {
+    use std::sync::Arc;
+
+    use async_trait::async_trait;
+    use serde_json::json;
+
+    use super::*;
+    use crate::{Database, InboundEvent, MultiplexerConfig};
+
+    struct Idle;
+
+    #[async_trait]
+    impl crate::AgentRunner for Idle {
+        async fn run(&self, _: &mut crate::SessionContext, _: InboundEvent) -> Result<()> {
+            Ok(())
+        }
+    }
+
+    async fn insert(pool: &SqlitePool, key: &SessionKey, state: &str) {
+        sqlx::query("INSERT INTO sessions (session_key, platform, guild_id, channel_id, thread_id, user_id, state_json) VALUES (?, ?, ?, ?, ?, ?, ?)")
+            .bind(key.storage_key())
+            .bind(&key.platform)
+            .bind(&key.guild_id)
+            .bind(&key.channel_id)
+            .bind(&key.thread_id)
+            .bind(&key.user_id)
+            .bind(state)
+            .execute(pool)
+            .await
+            .unwrap();
+    }
+
+    async fn state(pool: &SqlitePool, key: &SessionKey) -> Value {
+        let raw: String =
+            sqlx::query_scalar("SELECT state_json FROM sessions WHERE session_key = ?")
+                .bind(key.storage_key())
+                .fetch_one(pool)
+                .await
+                .unwrap();
+        serde_json::from_str(&raw).unwrap()
+    }
+
+    fn thread(channel: &str, ts: &str, bot: &str) -> SessionKey {
+        SessionKey::new("slack", Some("T1"), channel, Some(ts), "").with_bot_id(bot)
+    }
+
+    #[test]
+    fn classify_maps_lifecycle_events_only() {
+        assert_eq!(
+            classify(&json!({"type": "channel_archive", "channel": "C1"})),
+            Some(Lifecycle::Archived {
+                channel: "C1".into(),
+                archived: true
+            })
+        );
+        assert_eq!(
+            classify(&json!({"type": "group_archive", "channel": "G1"})),
+            Some(Lifecycle::Archived {
+                channel: "G1".into(),
+                archived: true
+            })
+        );
+        assert_eq!(
+            classify(&json!({"type": "channel_unarchive", "channel": "C1"})),
+            Some(Lifecycle::Archived {
+                channel: "C1".into(),
+                archived: false
+            })
+        );
+        assert_eq!(
+            classify(&json!({"type": "channel_deleted", "channel": "C1"})),
+            Some(Lifecycle::ChannelDeleted {
+                channel: "C1".into()
+            })
+        );
+        assert_eq!(
+            classify(
+                &json!({"type": "message", "subtype": "message_deleted", "channel": "C1", "deleted_ts": "1.0"})
+            ),
+            Some(Lifecycle::ThreadRootDeleted {
+                channel: "C1".into(),
+                thread_ts: "1.0".into()
+            })
+        );
+        assert_eq!(
+            classify(&json!({"type": "message", "channel": "C1", "ts": "1.0"})),
+            None
+        );
+        assert_eq!(
+            classify(&json!({"type": "app_mention", "channel": "C1"})),
+            None
+        );
+    }
+
+    #[tokio::test]
+    async fn archive_marks_bot_sessions_and_delete_clears_thread_binding() {
+        let db = Database::connect("sqlite::memory:").await.unwrap();
+        let pool = db.pool().clone();
+        let multiplexer =
+            SessionMultiplexer::new(pool.clone(), Arc::new(Idle), MultiplexerConfig::default());
+        let ours = thread("C1", "1.0", "UBOT");
+        let other_thread = thread("C1", "2.0", "UBOT");
+        let other_bot = thread("C1", "1.0", "UOTHER");
+        let elsewhere = thread("C2", "1.0", "UBOT");
+        let bound = r#"{"metadata":{"omo_thread_id":"thr-1"}}"#;
+        for key in [&ours, &other_thread, &other_bot, &elsewhere] {
+            insert(&pool, key, bound).await;
+        }
+
+        let archive = json!({"type": "channel_archive", "channel": "C1"});
+        assert!(handle(&multiplexer, &pool, "UBOT", &archive).await.unwrap());
+        assert_eq!(
+            state(&pool, &ours).await["metadata"]["thread_archived"],
+            json!(true)
+        );
+        assert_eq!(
+            state(&pool, &other_thread).await["metadata"]["thread_archived"],
+            json!(true)
+        );
+        assert!(state(&pool, &other_bot).await["metadata"]
+            .get("thread_archived")
+            .is_none());
+        assert!(state(&pool, &elsewhere).await["metadata"]
+            .get("thread_archived")
+            .is_none());
+
+        let unarchive = json!({"type": "channel_unarchive", "channel": "C1"});
+        assert!(handle(&multiplexer, &pool, "UBOT", &unarchive)
+            .await
+            .unwrap());
+        assert_eq!(
+            state(&pool, &ours).await["metadata"]["thread_archived"],
+            json!(false)
+        );
+
+        let root_deleted = json!({"type": "message", "subtype": "message_deleted", "channel": "C1", "deleted_ts": "1.0"});
+        assert!(handle(&multiplexer, &pool, "UBOT", &root_deleted)
+            .await
+            .unwrap());
+        assert!(state(&pool, &ours).await["metadata"]
+            .get("omo_thread_id")
+            .is_none());
+        assert_eq!(
+            state(&pool, &other_thread).await["metadata"]["omo_thread_id"],
+            "thr-1"
+        );
+        assert_eq!(
+            state(&pool, &other_bot).await["metadata"]["omo_thread_id"],
+            "thr-1"
+        );
+
+        let deleted = json!({"type": "channel_deleted", "channel": "C1"});
+        assert!(handle(&multiplexer, &pool, "UBOT", &deleted).await.unwrap());
+        assert!(state(&pool, &other_thread).await["metadata"]
+            .get("omo_thread_id")
+            .is_none());
+        assert_eq!(
+            state(&pool, &elsewhere).await["metadata"]["omo_thread_id"],
+            "thr-1"
+        );
+
+        let plain = json!({"type": "message", "channel": "C1", "ts": "3.0", "text": "hi"});
+        assert!(!handle(&multiplexer, &pool, "UBOT", &plain).await.unwrap());
+    }
+}
diff --git a/src/slack/mod.rs b/src/slack/mod.rs
new file mode 100644
index 0000000..45aac44
--- /dev/null
+++ b/src/slack/mod.rs
@@ -0,0 +1,376 @@
+//! Slack channel: Socket Mode ingress, Web API egress, slash commands and approval buttons.
+//!
+//! Shared contract for every submodule. Session keys use `platform = "slack"`,
+//! `guild_id = Some(team_id)` in channels (`None` in DMs), `channel_id` = Slack channel id,
+//! `thread_id = Some(thread_ts)` for threaded conversations, `user_id` = Slack user id in DMs
+//! and `bot_id = Some(bot user id)`. Platform message ids are Slack `ts` strings.
+
+pub mod api;
+pub mod backfill;
+pub mod buttons;
+pub mod commands;
+pub mod debounce;
+pub mod egress;
+pub mod home;
+pub mod ingress;
+pub mod interactive;
+pub mod lifecycle;
+pub mod mrkdwn;
+pub mod runtime;
+pub mod socket;
+
+use std::path::PathBuf;
+
+pub use api::SlackApi;
+pub use egress::SlackEgress;
+pub use runtime::SlackRuntime;
+
+pub const PLATFORM: &str = "slack";
+/// Owner Slack user id used when `SLACK_ALLOWED_USERS` is unset.
+pub const DEFAULT_OWNER_ID: &str = "U04M1JNJM8T";
+/// Slack rejects `text` longer than 40k; keep chunks well under the 4k display fold.
+pub const MESSAGE_LIMIT: usize = 3900;
+pub const DEFAULT_CHANNEL_CONTEXT_LIMIT: usize = 10;
+pub const MAX_CHANNEL_CONTEXT_LIMIT: usize = 25;
+
+/// Which bot-authored messages may start or continue a turn.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum AllowBots {
+    #[default]
+    None,
+    /// Only bot messages that @mention this bot.
+    Mentions,
+    All,
+}
+
+impl AllowBots {
+    pub fn parse(raw: Option<&str>) -> Self {
+        match raw
+            .map(|value| value.trim().to_ascii_lowercase())
+            .as_deref()
+        {
+            Some("all") => Self::All,
+            Some("mentions" | "mention") => Self::Mentions,
+            _ => Self::None,
+        }
+    }
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct SlackConfig {
+    pub bot_token: String,
+    pub app_token: String,
+    /// Users allowed to talk to the bot and press approval buttons. First entry is the owner.
+    pub allowed_users: Vec<String>,
+    /// Channels where every message (not only @mentions) starts or continues a turn.
+    pub free_response_channels: Vec<String>,
+    /// Answer a top-level channel @mention in a thread rooted at the mention.
+    pub auto_thread: bool,
+    pub attachment_dir: PathBuf,
+    /// Owner home channel (`SLACK_HOME_CHANNEL`); always a free-response channel too.
+    pub home_channel: Option<String>,
+    pub approval_mentions: bool,
+    pub allowed_channels: Vec<String>,
+    pub ignored_channels: Vec<String>,
+    pub allow_bots: AllowBots,
+    pub thread_require_mention: bool,
+    pub channel_context: bool,
+    pub channel_context_limit: usize,
+    pub channel_topic_context: bool,
+    pub processing_reactions: bool,
+    pub runtime_footer: bool,
+    pub missed_backfill: bool,
+    pub destructive_slash_confirm: bool,
+    pub allow_all_users: bool,
+}
+
+impl SlackConfig {
+    /// `None` when Slack is disabled (`OMON_SLACK_ENABLED=false`) or either token is missing.
+    ///
+    /// Tokens: `SLACK_BOT_TOKEN` / `SLACK_APP_TOKEN`, else the files named by
+    /// `SLACK_BOT_TOKEN_FILE` / `SLACK_APP_TOKEN_FILE`, else
+    /// `~/.omon/secrets/slack-bot-token` / `~/.omon/secrets/slack-app-token`.
+    ///
+    /// Behavior flags read `SLACK_<NAME>` and fall back to `DISCORD_<NAME>`. Id-valued settings
+    /// (users, channels, home channel) are Slack-only: a Discord snowflake never names a Slack
+    /// conversation, and an inherited channel allowlist would silence every Slack channel.
+    pub fn from_env(workspace_root: &std::path::Path) -> Option<Self> {
+        if std::env::var("OMON_SLACK_ENABLED")
+            .is_ok_and(|value| matches!(value.trim(), "0" | "false" | "no" | "off"))
+        {
+            return None;
+        }
+        let home = std::env::var_os("HOME").map(PathBuf::from)?;
+        let secrets = home.join(".omon").join("secrets");
+        let bot_token = token(
+            "SLACK_BOT_TOKEN",
+            "SLACK_BOT_TOKEN_FILE",
+            &secrets.join("slack-bot-token"),
+            "xoxb-",
+        )?;
+        let app_token = token(
+            "SLACK_APP_TOKEN",
+            "SLACK_APP_TOKEN_FILE",
+            &secrets.join("slack-app-token"),
+            "xapp-",
+        )?;
+        Some(Self::from_lookup(
+            bot_token,
+            app_token,
+            workspace_root.join("attachments").join("slack"),
+            &|name| std::env::var(name).ok(),
+        ))
+    }
+
+    fn from_lookup(
+        bot_token: String,
+        app_token: String,
+        attachment_dir: PathBuf,
+        lookup: &dyn Fn(&str) -> Option<String>,
+    ) -> Self {
+        let mut allowed_users = split_list(lookup("SLACK_ALLOWED_USERS"));
+        if allowed_users.is_empty() {
+            allowed_users.push(DEFAULT_OWNER_ID.to_owned());
+        }
+        let home_channels = split_list(lookup("SLACK_HOME_CHANNEL"));
+        let mut free_response_channels = split_list(lookup("SLACK_FREE_RESPONSE_CHANNELS"));
+        for channel in &home_channels {
+            if !free_response_channels.contains(channel) {
+                free_response_channels.push(channel.clone());
+            }
+        }
+        let destructive_slash_confirm = setting(lookup, "DESTRUCTIVE_SLASH_CONFIRM")
+            .or_else(|| non_empty(lookup("APPROVALS_DESTRUCTIVE_SLASH_CONFIRM")));
+        Self {
+            bot_token,
+            app_token,
+            allowed_users,
+            free_response_channels,
+            auto_thread: parse_flag(non_empty(lookup("SLACK_AUTO_THREAD")).as_deref(), true),
+            attachment_dir,
+            home_channel: home_channels.into_iter().next(),
+            approval_mentions: flag(lookup, "APPROVAL_MENTIONS", true),
+            allowed_channels: split_list(lookup("SLACK_ALLOWED_CHANNELS")),
+            ignored_channels: split_list(lookup("SLACK_IGNORED_CHANNELS")),
+            allow_bots: AllowBots::parse(setting(lookup, "ALLOW_BOTS").as_deref()),
+            thread_require_mention: flag(lookup, "THREAD_REQUIRE_MENTION", false),
+            channel_context: flag(lookup, "CHANNEL_CONTEXT", true),
+            channel_context_limit: setting(lookup, "CHANNEL_CONTEXT_LIMIT")
+                .and_then(|value| value.trim().parse::<usize>().ok())
+                .unwrap_or(DEFAULT_CHANNEL_CONTEXT_LIMIT)
+                .min(MAX_CHANNEL_CONTEXT_LIMIT),
+            channel_topic_context: flag(lookup, "CHANNEL_TOPIC_CONTEXT", true),
+            processing_reactions: flag(lookup, "PROCESSING_REACTIONS", true),
+            runtime_footer: flag(lookup, "RUNTIME_FOOTER", false),
+            missed_backfill: flag(lookup, "MISSED_BACKFILL", true),
+            destructive_slash_confirm: parse_flag(destructive_slash_confirm.as_deref(), true),
+            allow_all_users: flag(lookup, "ALLOW_ALL_USERS", false),
+        }
+    }
+
+    /// Fixed tokens and contract defaults, for unit tests in every lane.
+    pub fn test_default() -> Self {
+        Self::from_lookup(
+            "xoxb-test".into(),
+            "xapp-test".into(),
+            PathBuf::from("/tmp/omon-slack-test"),
+            &|_| None,
+        )
+    }
+
+    pub fn owner_id(&self) -> &str {
+        self.allowed_users
+            .first()
+            .map_or(DEFAULT_OWNER_ID, String::as_str)
+    }
+
+    pub fn is_allowed(&self, user: &str) -> bool {
+        self.allowed_users.iter().any(|id| id == user)
+    }
+}
+
+/// Owner Slack user id from the environment, for code that has no `SlackConfig` at hand.
+pub fn owner_id() -> String {
+    list("SLACK_ALLOWED_USERS")
+        .into_iter()
+        .next()
+        .unwrap_or_else(|| DEFAULT_OWNER_ID.to_owned())
+}
+
+/// Slack home channels from `SLACK_HOME_CHANNEL`, for code that has no `SlackConfig` at hand.
+pub fn home_channels() -> Vec<String> {
+    list("SLACK_HOME_CHANNEL")
+}
+
+fn list(name: &str) -> Vec<String> {
+    split_list(std::env::var(name).ok())
+}
+
+fn split_list(value: Option<String>) -> Vec<String> {
+    value
+        .map(|value| {
+            value
+                .split(',')
+                .map(str::trim)
+                .filter(|item| !item.is_empty())
+                .map(str::to_owned)
+                .collect()
+        })
+        .unwrap_or_default()
+}
+
+fn non_empty(value: Option<String>) -> Option<String> {
+    value.filter(|value| !value.trim().is_empty())
+}
+
+fn setting(lookup: &dyn Fn(&str) -> Option<String>, name: &str) -> Option<String> {
+    non_empty(lookup(&format!("SLACK_{name}")))
+        .or_else(|| non_empty(lookup(&format!("DISCORD_{name}"))))
+}
+
+fn flag(lookup: &dyn Fn(&str) -> Option<String>, name: &str, default: bool) -> bool {
+    parse_flag(setting(lookup, name).as_deref(), default)
+}
+
+fn parse_flag(raw: Option<&str>, default: bool) -> bool {
+    match raw
+        .map(|value| value.trim().to_ascii_lowercase())
+        .as_deref()
+    {
+        Some("1" | "true" | "yes" | "on") => true,
+        Some("0" | "false" | "no" | "off") => false,
+        _ => default,
+    }
+}
+
+fn token(
+    var: &str,
+    file_var: &str,
+    default_file: &std::path::Path,
+    prefix: &str,
+) -> Option<String> {
+    let raw = std::env::var(var).ok().or_else(|| {
+        let path = std::env::var_os(file_var)
+            .map(PathBuf::from)
+            .unwrap_or_else(|| default_file.to_path_buf());
+        std::fs::read_to_string(path).ok()
+    })?;
+    let value = raw.trim().trim_matches('"').to_owned();
+    value.starts_with(prefix).then_some(value)
+}
+
+#[cfg(test)]
+mod tests {
+    use std::collections::HashMap;
+
+    use super::*;
+
+    fn config_from(pairs: &[(&str, &str)]) -> SlackConfig {
+        let env: HashMap<String, String> = pairs
+            .iter()
+            .map(|(key, value)| ((*key).to_owned(), (*value).to_owned()))
+            .collect();
+        SlackConfig::from_lookup(
+            "xoxb-t".into(),
+            "xapp-t".into(),
+            PathBuf::from("/tmp"),
+            &move |name| env.get(name).cloned(),
+        )
+    }
+
+    #[test]
+    fn defaults_match_the_contract() {
+        let config = SlackConfig::test_default();
+        assert_eq!(config.allowed_users, [DEFAULT_OWNER_ID]);
+        assert_eq!(config.home_channel, None);
+        assert!(config.approval_mentions);
+        assert!(config.allowed_channels.is_empty() && config.ignored_channels.is_empty());
+        assert_eq!(config.allow_bots, AllowBots::None);
+        assert!(!config.thread_require_mention);
+        assert!(config.channel_context);
+        assert_eq!(config.channel_context_limit, 10);
+        assert!(config.channel_topic_context);
+        assert!(config.processing_reactions);
+        assert!(!config.runtime_footer);
+        assert!(config.missed_backfill);
+        assert!(config.destructive_slash_confirm);
+        assert!(!config.allow_all_users);
+        assert!(config.auto_thread);
+    }
+
+    #[test]
+    fn slack_settings_win_and_discord_flags_fill_gaps() {
+        let config = config_from(&[
+            ("SLACK_RUNTIME_FOOTER", "true"),
+            ("DISCORD_RUNTIME_FOOTER", "false"),
+            ("DISCORD_CHANNEL_CONTEXT", "off"),
+            ("DISCORD_ALLOW_BOTS", "mentions"),
+            ("SLACK_CHANNEL_CONTEXT_LIMIT", "99"),
+            ("DISCORD_MISSED_BACKFILL", "0"),
+            ("APPROVALS_DESTRUCTIVE_SLASH_CONFIRM", "false"),
+        ]);
+        assert!(config.runtime_footer);
+        assert!(!config.channel_context);
+        assert_eq!(config.allow_bots, AllowBots::Mentions);
+        assert_eq!(config.channel_context_limit, MAX_CHANNEL_CONTEXT_LIMIT);
+        assert!(!config.missed_backfill);
+        assert!(!config.destructive_slash_confirm);
+    }
+
+    #[test]
+    fn id_settings_never_inherit_discord_values() {
+        let config = config_from(&[
+            ("DISCORD_ALLOWED_CHANNELS", "1529738911377657967"),
+            ("DISCORD_IGNORED_CHANNELS", "1"),
+            ("DISCORD_HOME_CHANNEL", "2"),
+            ("DISCORD_ALLOWED_USERS", "414011632306618368"),
+        ]);
+        assert!(config.allowed_channels.is_empty());
+        assert!(config.ignored_channels.is_empty());
+        assert_eq!(config.home_channel, None);
+        assert_eq!(config.allowed_users, [DEFAULT_OWNER_ID]);
+    }
+
+    #[test]
+    fn home_channel_is_also_free_response() {
+        let config = config_from(&[
+            ("SLACK_HOME_CHANNEL", " CHOME "),
+            ("SLACK_FREE_RESPONSE_CHANNELS", "CFREE,CHOME"),
+        ]);
+        assert_eq!(config.home_channel.as_deref(), Some("CHOME"));
+        assert_eq!(config.free_response_channels, ["CFREE", "CHOME"]);
+    }
+
+    #[test]
+    fn allow_bots_parses_known_modes_only() {
+        assert_eq!(AllowBots::parse(Some(" ALL ")), AllowBots::All);
+        assert_eq!(AllowBots::parse(Some("mention")), AllowBots::Mentions);
+        assert_eq!(AllowBots::parse(Some("everyone")), AllowBots::None);
+        assert_eq!(AllowBots::parse(None), AllowBots::None);
+    }
+
+    #[test]
+    fn token_rejects_wrong_prefix_and_trims() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("tok");
+        std::fs::write(&path, "  xoxb-abc\n").unwrap();
+        assert_eq!(
+            token(
+                "OMON_TEST_UNSET_SLACK_VAR",
+                "OMON_TEST_UNSET_SLACK_FILE",
+                &path,
+                "xoxb-"
+            ),
+            Some("xoxb-abc".into())
+        );
+        assert_eq!(
+            token(
+                "OMON_TEST_UNSET_SLACK_VAR",
+                "OMON_TEST_UNSET_SLACK_FILE",
+                &path,
+                "xapp-"
+            ),
+            None
+        );
+    }
+}
