+} from './pickers'
+import { Tooltip } from './Tooltip'
+
+export type PropertyKind = 'status' | 'priority' | 'assignee' | 'labels' | 'project' | 'cycle' | 'estimate' | 'due' | 'parent'
+
+export interface PropertyChipProps {
+  kind: PropertyKind
+  issue: Issue
+  variant?: 'compact' | 'full'
+  issueIds?: string[]
+  maxLabels?: number
+  className?: string
+}
+
+const PICKERS: Record<PropertyKind, React.ComponentType<PickerProps>> = {
+  status: StatusPicker,
+  priority: PriorityPicker,
+  assignee: AssigneePicker,
+  labels: LabelPicker,
+  project: ProjectPicker,
+  cycle: CyclePicker,
+  estimate: EstimatePicker,
+  due: DueDatePicker,
+  parent: ParentPicker,
+}
+
+const TOOLTIPS: Record<PropertyKind, { label: string; kbd: string[] }> = {
+  status: { label: 'Change status', kbd: ['S'] },
+  priority: { label: 'Change priority', kbd: ['P'] },
+  assignee: { label: 'Assign to', kbd: ['A'] },
+  labels: { label: 'Change labels', kbd: ['L'] },
+  project: { label: 'Add to project', kbd: ['shift', 'P'] },
+  cycle: { label: 'Move to cycle', kbd: ['shift', 'C'] },
+  estimate: { label: 'Set estimate', kbd: ['shift', 'E'] },
+  due: { label: 'Set due date', kbd: ['shift', 'D'] },
+  parent: { label: 'Set parent issue', kbd: ['mod', 'shift', 'P'] },
+}
+
+export function PropertyChip({ kind, issue, variant = 'compact', issueIds, maxLabels = 3, className }: PropertyChipProps) {
+  const t = useTracker()
+  const [open, setOpen] = useState(false)
+  const ref = useRef<HTMLButtonElement | null>(null)
+  const full = variant === 'full'
+
+  let content: React.ReactNode = null
+  let iconOnly = false
+  let empty = false
+  let tone: string | undefined
+  let tooltip: React.ReactNode = TOOLTIPS[kind].label
+
+  switch (kind) {
+    case 'status': {
+      const state = t.statesById.get(issue.state_id)
+      const states = t.teamStates(issue.team_id)
+      const icon = state ? (
+        <StatusIcon type={state.type} color={state.color} progress={stateProgress(state, states)} />
+      ) : (
+        <CircleDashed size={14} color="var(--text-3)" />
+      )
+      iconOnly = !full
+      tooltip = state?.name ?? 'Status'
+      content = full ? (
+        <>
+          {icon}
+          <span className="lui-chip-text">{state?.name ?? 'Unknown'}</span>
+        </>
+      ) : (
+        icon
+      )
+      break
+    }
+    case 'priority': {
+      iconOnly = !full
+      tooltip = PRIORITY_LABELS[issue.priority]
+      empty = issue.priority === 0
+      content = full ? (
+        <>
+          <PriorityIcon priority={issue.priority} />
+          <span className="lui-chip-text">{empty ? 'Set priority' : PRIORITY_LABELS[issue.priority]}</span>
+        </>
+      ) : (
+        <PriorityIcon priority={issue.priority} />
+      )
+      break
+    }
+    case 'assignee': {
+      const user = issue.assignee_id ? t.usersById.get(issue.assignee_id) ?? null : null
+      iconOnly = !full
+      empty = !user
+      tooltip = user ? `Assigned to ${user.name}` : 'Unassigned'
+      content = full ? (
+        <>
+          {user ? <Avatar user={user} size={18} /> : <UserRound size={14} color="var(--text-3)" />}
+          <span className="lui-chip-text">{user ? user.name : 'Assign'}</span>
+        </>
+      ) : (
+        <Avatar user={user} size={18} />
+      )
+      break
+    }
+    case 'labels': {
+      const labels = issue.label_ids.map((id) => t.labelsById.get(id)).filter((l): l is NonNullable<typeof l> => Boolean(l))
+      empty = labels.length === 0
+      if (empty) {
+        if (!full) return null
+        content = (
+          <>
+            <Tag size={14} color="var(--text-3)" />
+            <span>Add label</span>
+          </>
+        )
+        break
+      }
+      tooltip = labels.map((l) => l.name).join(', ')
+      if (!full && labels.length > maxLabels) {
+        return (
+          <ChipButton
+            refEl={ref}
+            className={className}
+            tooltip={tooltip}
+            onOpen={() => setOpen(true)}
+            picker={<LabelPicker issueIds={issueIds ?? [issue.id]} anchor={ref.current} open={open} onOpenChange={setOpen} />}
+          >
+            <span className="lui-chip-group">
+              {labels.slice(0, 3).map((l) => (
+                <LabelDot key={l.id} color={l.color} />
+              ))}
+            </span>
+            <span className="lui-chip-text">{labels.length} labels</span>
+          </ChipButton>
+        )
+      }
+      if (full) {
+        content = (
+          <span className="lui-chip-group" style={{ flexWrap: 'wrap', gap: 6 }}>
+            {labels.map((l) => (
+              <span key={l.id} className="lui-chip">
+                <LabelDot color={l.color} />
+                <span className="lui-chip-text">{l.name}</span>
+              </span>
+            ))}
+          </span>
+        )
+        break
+      }
+      return (
+        <span className="lui-chip-group">
+          {labels.map((l, index) => (
+            <ChipButton
+              key={l.id}
+              className={className}
+              tooltip={l.description || l.name}
+              onOpen={(el) => {
+                ref.current = el
+                setOpen(true)
+              }}
+              picker={index === 0 ? <LabelPicker issueIds={issueIds ?? [issue.id]} anchor={ref.current} open={open} onOpenChange={setOpen} /> : null}
+            >
+              <LabelDot color={l.color} />
+              <span className="lui-chip-text">{l.name}</span>
+            </ChipButton>
+          ))}
+        </span>
+      )
+    }
+    case 'project': {
+      const project = issue.project_id ? t.projectsById.get(issue.project_id) : undefined
+      empty = !project
+      if (empty && !full) return null
+      tooltip = project?.name ?? TOOLTIPS.project.label
+      content = project ? (
+        <>
+          <ProjectIcon icon={project.icon} color={project.color} />
+          <span className="lui-chip-text">{project.name}</span>
+        </>
+      ) : (
+        <>
+          <ProjectIcon icon="box" color="var(--text-3)" />
+          <span>Add to project</span>
+        </>
+      )
+      break
+    }
+    case 'cycle': {
+      const cycle = issue.cycle_id ? t.cyclesById.get(issue.cycle_id) : undefined
+      empty = !cycle
+      if (empty && !full) return null
+      content = cycle ? (
+        <>
+          <CycleIcon progress={cycleProgressRatio(cycle)} />
+          <span className="lui-chip-text">{cycleLabel(cycle)}</span>
+        </>
+      ) : (
+        <>
+          <CycleIcon progress={0} />
+          <span>Add to cycle</span>
+        </>
+      )
+      break
+    }
+    case 'estimate': {
+      empty = issue.estimate === null
+      if (empty && !full) return null
+      tooltip = issue.estimate === null ? TOOLTIPS.estimate.label : `Estimate: ${estimateLabel(issue.estimate)}`
+      content = (
+        <>
+          <EstimateIcon />
+          <span className="lui-chip-text">{issue.estimate === null ? 'Set estimate' : full ? estimateLabel(issue.estimate) : issue.estimate}</span>
+        </>
+      )
+      break
+    }
+    case 'due': {
+      empty = !issue.due_date
+      if (empty && !full) return null
+      const state = t.statesById.get(issue.state_id)
+      const due = dueState(issue.due_date, state ? isClosedType(state.type) : false)
+      tone = due === 'overdue' ? 'lui-chip--overdue' : due === 'soon' ? 'lui-chip--soon' : undefined
+      tooltip = issue.due_date ? `Due ${shortDate(issue.due_date)}${due === 'overdue' ? ' (overdue)' : ''}` : TOOLTIPS.due.label
+      content = (
+        <>
+          <CalendarDays size={14} />
+          <span className="lui-chip-text">{issue.due_date ? shortDate(issue.due_date) : 'Set due date'}</span>
+        </>
+      )
+      break
+    }
+    case 'parent': {
+      const parent = issue.parent_id ? t.issuesById.get(issue.parent_id) : undefined
+      empty = !parent
+      if (empty && !full) return null
+      const state = parent ? t.statesById.get(parent.state_id) : undefined
+      tooltip = parent ? `${parent.identifier} ${parent.title}` : TOOLTIPS.parent.label
+      content = parent ? (
+        <>
+          {state && <StatusIcon type={state.type} color={state.color} progress={stateProgress(state, t.teamStates(parent.team_id))} />}
+          <span className="t-3">{parent.identifier}</span>
+          <span className="lui-chip-text">{parent.title}</span>
+        </>
+      ) : (
+        <span>Set parent issue</span>
+      )
+      break
+    }
+  }
+
+  const Picker = PICKERS[kind]
+  const picker = <Picker issueIds={issueIds ?? [issue.id]} anchor={ref.current} open={open} onOpenChange={setOpen} />
+  const baseClass = full ? `lui-prop${empty ? ' lui-prop--empty' : ''}` : iconOnly ? 'lui-chip-icon' : `lui-chip${tone ? ` ${tone}` : ''}`
+
+  return (
+    <ChipButton
+      refEl={ref}
+      className={[baseClass, full && tone ? tone : '', className ?? ''].filter(Boolean).join(' ')}
+      raw
+      tooltip={full ? null : tooltip}
+      kbd={TOOLTIPS[kind].kbd}
+      onOpen={() => setOpen(true)}
+      picker={picker}
+    >
+      {content}
+    </ChipButton>
+  )
+}
+
+interface ChipButtonProps {
+  refEl?: React.MutableRefObject<HTMLButtonElement | null>
+  className?: string
+  raw?: boolean
+  tooltip: React.ReactNode
+  kbd?: string[]
+  onOpen: (el: HTMLButtonElement) => void
+  picker: React.ReactNode
+  children: React.ReactNode
+}
+
+function ChipButton({ refEl, className, raw, tooltip, kbd, onOpen, picker, children }: ChipButtonProps) {
+  const button = (
+    <button
+      type="button"
+      ref={
+        refEl
+          ? (node) => {
+              refEl.current = node
+            }
+          : undefined
+      }
+      className={raw ? className : ['lui-chip', className ?? ''].filter(Boolean).join(' ')}
+      onClick={(event) => {
+        event.stopPropagation()
+        event.preventDefault()
+        onOpen(event.currentTarget)
+      }}
+      onDoubleClick={(event) => event.stopPropagation()}
+      onPointerDown={(event) => event.stopPropagation()}
+      onMouseDown={(event) => event.stopPropagation()}
+    >
+      {children}
+    </button>
+  )
+  return (
+    <>
+      {tooltip ? (
+        <Tooltip content={tooltip} kbd={kbd}>
+          {button}
+        </Tooltip>
+      ) : (
+        button
+      )}
+      {picker}
+    </>
+  )
+}
diff --git a/web/src/tracker/ui/Toast.tsx b/web/src/tracker/ui/Toast.tsx
new file mode 100644
index 0000000..76e687d
--- /dev/null
+++ b/web/src/tracker/ui/Toast.tsx
@@ -0,0 +1,99 @@
+import { useEffect, useState, useSyncExternalStore } from 'react'
+import { CircleAlert, CircleCheck, X } from 'lucide-react'
+import { Button, IconButton } from './Button'
+import { Portal } from './layer'
+
+export interface ToastOptions {
+  action?: { label: string; onClick: () => void }
+  kind?: 'info' | 'success' | 'error'
+  duration?: number
+}
+
+interface ToastEntry extends ToastOptions {
+  id: number
+  message: string
+}
+
+let toasts: ToastEntry[] = []
+let nextId = 0
+const listeners = new Set<() => void>()
+
+function emit() {
+  for (const listener of listeners) listener()
+}
+
+export function dismissToast(id: number) {
+  toasts = toasts.filter((t) => t.id !== id)
+  emit()
+}
+
+export function toast(message: string, opts: ToastOptions = {}): number {
+  const id = ++nextId
+  toasts = [...toasts.slice(-4), { id, message, ...opts }]
+  emit()
+  return id
+}
+
+toast.error = (message: string, opts: Omit<ToastOptions, 'kind'> = {}) => toast(message, { ...opts, kind: 'error' })
+toast.success = (message: string, opts: Omit<ToastOptions, 'kind'> = {}) => toast(message, { ...opts, kind: 'success' })
+
+function subscribe(listener: () => void) {
+  listeners.add(listener)
+  return () => {
+    listeners.delete(listener)
+  }
+}
+
+function snapshot() {
+  return toasts
+}
+
+function ToastItem({ entry }: { entry: ToastEntry }) {
+  const [paused, setPaused] = useState(false)
+  const duration = entry.duration ?? (entry.action ? 6000 : 4000)
+  useEffect(() => {
+    if (paused || duration <= 0) return
+    const timer = window.setTimeout(() => dismissToast(entry.id), duration)
+    return () => window.clearTimeout(timer)
+  }, [paused, duration, entry.id])
+
+  return (
+    <div
+      className={`lui-toast${entry.kind ? ` lui-toast--${entry.kind}` : ''}`}
+      role={entry.kind === 'error' ? 'alert' : 'status'}
+      onMouseEnter={() => setPaused(true)}
+      onMouseLeave={() => setPaused(false)}
+    >
+      {entry.kind === 'error' && <CircleAlert size={16} className="lui-toast-icon" />}
+      {entry.kind === 'success' && <CircleCheck size={16} className="lui-toast-icon" />}
+      <span className="lui-toast-msg">{entry.message}</span>
+      {entry.action && (
+        <Button
+          size="sm"
+          variant="secondary"
+          onClick={() => {
+            entry.action?.onClick()
+            dismissToast(entry.id)
+          }}
+        >
+          {entry.action.label}
+        </Button>
+      )}
+      <IconButton label="Dismiss" size="sm" icon={<X size={14} />} onClick={() => dismissToast(entry.id)} />
+    </div>
+  )
+}
+
+export function Toaster() {
+  const list = useSyncExternalStore(subscribe, snapshot, snapshot)
+  if (list.length === 0) return null
+  return (
+    <Portal>
+      <div className="lui-toaster" aria-live="polite">
+        {list.map((entry) => (
+          <ToastItem key={entry.id} entry={entry} />
+        ))}
+      </div>
+    </Portal>
+  )
+}
diff --git a/web/src/tracker/ui/Tooltip.tsx b/web/src/tracker/ui/Tooltip.tsx
new file mode 100644
index 0000000..6d06a06
--- /dev/null
+++ b/web/src/tracker/ui/Tooltip.tsx
@@ -0,0 +1,125 @@
+import React, { cloneElement, isValidElement, useCallback, useEffect, useLayoutEffect, useRef, useState } from 'react'
+import { Kbd } from './Kbd'
+import { Portal } from './layer'
+
+export type Side = 'top' | 'bottom' | 'left' | 'right'
+
+interface TooltipProps {
+  content: React.ReactNode
+  kbd?: string[]
+  side?: Side
+  delay?: number
+  disabled?: boolean
+  children: React.ReactNode
+}
+
+const GAP = 6
+
+export function Tooltip({ content, kbd, side = 'bottom', delay = 500, disabled, children }: TooltipProps) {
+  const [open, setOpen] = useState(false)
+  const [pos, setPos] = useState<{ left: number; top: number } | null>(null)
+  const triggerRef = useRef<HTMLElement | null>(null)
+  const tipRef = useRef<HTMLDivElement | null>(null)
+  const timer = useRef<number | undefined>(undefined)
+
+  const show = useCallback(() => {
+    if (disabled) return
+    window.clearTimeout(timer.current)
+    timer.current = window.setTimeout(() => setOpen(true), delay)
+  }, [delay, disabled])
+  const hide = useCallback(() => {
+    window.clearTimeout(timer.current)
+    setOpen(false)
+    setPos(null)
+  }, [])
+
+  useEffect(() => () => window.clearTimeout(timer.current), [])
+  useEffect(() => {
+    if (disabled) hide()
+  }, [disabled, hide])
+
+  useLayoutEffect(() => {
+    if (!open || !triggerRef.current || !tipRef.current) return
+    const r = triggerRef.current.getBoundingClientRect()
+    const t = tipRef.current.getBoundingClientRect()
+    let left = r.left + r.width / 2 - t.width / 2
+    let top = r.bottom + GAP
+    if (side === 'top') top = r.top - t.height - GAP
+    if (side === 'left') {
+      left = r.left - t.width - GAP
+      top = r.top + r.height / 2 - t.height / 2
+    }
+    if (side === 'right') {
+      left = r.right + GAP
+      top = r.top + r.height / 2 - t.height / 2
+    }
+    if (side === 'bottom' && top + t.height > window.innerHeight - 4) top = r.top - t.height - GAP
+    if (side === 'top' && top < 4) top = r.bottom + GAP
+    left = Math.min(Math.max(4, left), window.innerWidth - t.width - 4)
+    top = Math.min(Math.max(4, top), window.innerHeight - t.height - 4)
+    setPos({ left, top })
+  }, [open, side])
+
+  const hasContent = content !== null && content !== undefined && content !== ''
+  const tip =
+    open && hasContent ? (
+      <Portal>
+        <div
+          ref={tipRef}
+          role="tooltip"
+          className="lui-tooltip"
+          style={pos ? { left: pos.left, top: pos.top } : { left: -9999, top: -9999 }}
+        >
+          <span>{content}</span>
+          {kbd && kbd.length > 0 && <Kbd keys={kbd} />}
+        </div>
+      </Portal>
+    ) : null
+
+  const handlers = {
+    onMouseEnter: show,
+    onMouseLeave: hide,
+    onFocus: show,
+    onBlur: hide,
+    onPointerDown: hide,
+  }
+
+  if (isValidElement(children) && typeof children.type === 'string') {
+    const child = children as React.ReactElement<Record<string, unknown>>
+    const props = child.props as Record<string, unknown>
+    const originalRef = (child as unknown as { ref?: React.Ref<HTMLElement> }).ref
+    const chain = (name: keyof typeof handlers) => (event: unknown) => {
+      const original = props[name] as ((e: unknown) => void) | undefined
+      original?.(event)
+      handlers[name]()
+    }
+    return (
+      <>
+        {cloneElement(child, {
+          ref: (node: HTMLElement | null) => {
+            triggerRef.current = node
+            if (typeof originalRef === 'function') originalRef(node)
+            else if (originalRef && typeof originalRef === 'object') {
+              ;(originalRef as React.MutableRefObject<HTMLElement | null>).current = node
+            }
+          },
+          onMouseEnter: chain('onMouseEnter'),
+          onMouseLeave: chain('onMouseLeave'),
+          onFocus: chain('onFocus'),
+          onBlur: chain('onBlur'),
+          onPointerDown: chain('onPointerDown'),
+        })}
+        {tip}
+      </>
+    )
+  }
+
+  return (
+    <span className="lui-tooltip-trigger" ref={(node) => {
+        triggerRef.current = node
+      }} {...handlers}>
+      {children}
+      {tip}
+    </span>
+  )
+}
diff --git a/web/src/tracker/ui/icons.tsx b/web/src/tracker/ui/icons.tsx
new file mode 100644
index 0000000..2931bb1
--- /dev/null
+++ b/web/src/tracker/ui/icons.tsx
@@ -0,0 +1,281 @@
+import React from 'react'
+import {
+  BookOpen,
+  Bot,
+  Box,
+  Briefcase,
+  Code,
+  Compass,
+  Cpu,
+  Database,
+  Flag,
+  Globe,
+  Heart,
+  Hexagon,
+  Layers,
+  Lightbulb,
+  Map as MapIcon,
+  Package,
+  Puzzle,
+  Rocket,
+  Shield,
+  Sparkles,
+  Star,
+  Target,
+  Users,
+  Zap,
+  type LucideIcon,
+} from 'lucide-react'
+import type { Priority, StateType } from '../types'
+
+interface SvgBaseProps {
+  size?: number
+  className?: string
+  style?: React.CSSProperties
+  title?: string
+}
+
+function Svg({ size = 14, className, style, title, children, viewBox = '0 0 14 14' }: SvgBaseProps & { children: React.ReactNode; viewBox?: string }) {
+  return (
+    <svg
+      width={size}
+      height={size}
+      viewBox={viewBox}
+      fill="none"
+      className={className}
+      style={{ flex: 'none', display: 'block', ...style }}
+      role={title ? 'img' : undefined}
+      aria-label={title}
+      aria-hidden={title ? undefined : true}
+    >
+      {title && <title>{title}</title>}
+      {children}
+    </svg>
+  )
+}
+
+export interface StatusIconProps extends SvgBaseProps {
+  type: StateType
+  color: string
+  progress?: number
+}
+
+function piePath(progress: number): string {
+  const p = Math.min(0.999, Math.max(0.001, progress))
+  const r = 3
+  const cx = 7
+  const cy = 7
+  const angle = p * Math.PI * 2 - Math.PI / 2
+  const x = cx + r * Math.cos(angle)
+  const y = cy + r * Math.sin(angle)
+  const large = p > 0.5 ? 1 : 0
+  return `M ${cx} ${cy} L ${cx} ${cy - r} A ${r} ${r} 0 ${large} 1 ${x.toFixed(3)} ${y.toFixed(3)} Z`
+}
+
+export function StatusIcon({ type, color, progress, size = 14, className, style, title }: StatusIconProps) {
+  switch (type) {
+    case 'backlog':
+      return (
+        <Svg size={size} className={className} style={style} title={title}>
+          <circle cx="7" cy="7" r="6" stroke={color} strokeWidth="1.5" strokeDasharray="1.4 1.74" strokeDashoffset="0.65" />
+        </Svg>
+      )
+    case 'unstarted':
+      return (
+        <Svg size={size} className={className} style={style} title={title}>
+          <circle cx="7" cy="7" r="6" stroke={color} strokeWidth="1.5" />
+        </Svg>
+      )
+    case 'started': {
+      const value = progress ?? 0.5
+      return (
+        <Svg size={size} className={className} style={style} title={title}>
+          <circle cx="7" cy="7" r="6" stroke={color} strokeWidth="1.5" />
+          {value >= 0.999 ? <circle cx="7" cy="7" r="3" fill={color} /> : <path d={piePath(value)} fill={color} />}
+        </Svg>
+      )
+    }
+    case 'completed':
+      return (
+        <Svg size={size} className={className} style={style} title={title}>
+          <circle cx="7" cy="7" r="6.25" fill={color} stroke={color} strokeWidth="1.5" />
+          <path d="M4.4 7.2 6.2 9 9.7 5.3" stroke="var(--panel, #fff)" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" />
+        </Svg>
+      )
+    case 'canceled':
+      return (
+        <Svg size={size} className={className} style={style} title={title}>
+          <circle cx="7" cy="7" r="6.25" fill={color} stroke={color} strokeWidth="1.5" />
+          <path d="M5 5 9 9M9 5 5 9" stroke="var(--panel, #fff)" strokeWidth="1.5" strokeLinecap="round" />
+        </Svg>
+      )
+    case 'triage':
+      return (
+        <Svg size={size} className={className} style={style} title={title}>
+          <circle cx="7" cy="7" r="6.25" fill={color} stroke={color} strokeWidth="1.5" />
+          <path
+            d="M3.6 5.6h5.2M7.3 4l1.6 1.6-1.6 1.6M10.4 8.4H5.2M6.7 6.8 5.1 8.4 6.7 10"
+            stroke="var(--panel, #fff)"
+            strokeWidth="1.2"
+            strokeLinecap="round"
+            strokeLinejoin="round"
+          />
+        </Svg>
+      )
+  }
+}
+
+export interface PriorityIconProps extends SvgBaseProps {
+  priority: Priority
+}
+
+export function PriorityIcon({ priority, size = 14, className, style, title }: PriorityIconProps) {
+  if (priority === 0) {
+    return (
+      <Svg size={size} className={className} style={style} title={title ?? 'No priority'} viewBox="0 0 16 16">
+        <rect x="1.5" y="7.25" width="3" height="1.5" rx="0.5" fill="var(--text-3)" />
+        <rect x="6.5" y="7.25" width="3" height="1.5" rx="0.5" fill="var(--text-3)" />
+        <rect x="11.5" y="7.25" width="3" height="1.5" rx="0.5" fill="var(--text-3)" />
+      </Svg>
+    )
+  }
+  if (priority === 1) {
+    return (
+      <Svg size={size} className={className} style={style} title={title ?? 'Urgent'} viewBox="0 0 16 16">
+        <rect x="1" y="1" width="14" height="14" rx="3" fill="var(--urgent)" />
+        <path d="M8 4v5" stroke="#fff" strokeWidth="1.8" strokeLinecap="round" />
+        <circle cx="8" cy="11.6" r="1.05" fill="#fff" />
+      </Svg>
+    )
+  }
+  const filled = priority === 2 ? 3 : priority === 3 ? 2 : 1
+  const bars = [
+    { x: 1.5, y: 8, h: 6 },
+    { x: 6.5, y: 5, h: 9 },
+    { x: 11.5, y: 2, h: 12 },
+  ]
+  const label = priority === 2 ? 'High' : priority === 3 ? 'Medium' : 'Low'
+  return (
+    <Svg size={size} className={className} style={style} title={title ?? label} viewBox="0 0 16 16">
+      {bars.map((bar, i) => (
+        <rect
+          key={i}
+          x={bar.x}
+          y={bar.y}
+          width="3"
+          height={bar.h}
+          rx="1"
+          fill="var(--text-2)"
+          fillOpacity={i < filled ? 1 : 0.28}
+        />
+      ))}
+    </Svg>
+  )
+}
+
+export function LabelDot({ color, size = 8, className }: { color: string; size?: number; className?: string }) {
+  return (
+    <span
+      aria-hidden
+      className={className}
+      style={{ display: 'inline-block', flex: 'none', width: size, height: size, borderRadius: 9999, background: color }}
+    />
+  )
+}
+
+const PROJECT_ICONS: Record<string, LucideIcon> = {
+  box: Box,
+  rocket: Rocket,
+  target: Target,
+  flag: Flag,
+  star: Star,
+  zap: Zap,
+  layers: Layers,
+  code: Code,
+  globe: Globe,
+  book: BookOpen,
+  heart: Heart,
+  compass: Compass,
+  briefcase: Briefcase,
+  map: MapIcon,
+  users: Users,
+  hexagon: Hexagon,
+  cpu: Cpu,
+  database: Database,
+  shield: Shield,
+  sparkles: Sparkles,
+  puzzle: Puzzle,
+  package: Package,
+  lightbulb: Lightbulb,
+  bot: Bot,
+}
+
+export const PROJECT_ICON_NAMES = Object.keys(PROJECT_ICONS)
+
+export function iconComponent(name: string | null | undefined): LucideIcon {
+  return (name && PROJECT_ICONS[name]) || Box
+}
+
+export function ProjectIcon({ icon, color, size = 14, className }: { icon: string; color: string; size?: number; className?: string }) {
+  const Icon = iconComponent(icon)
+  return <Icon size={size} color={color} strokeWidth={2} className={className} style={{ flex: 'none' }} aria-hidden />
+}
+
+export function CycleIcon({ progress, size = 14, className, color = 'var(--text-3)' }: { progress: number; size?: number; className?: string; color?: string }) {
+  const p = Math.min(1, Math.max(0, progress))
+  const r = 5.25
+  const circumference = 2 * Math.PI * r
+  return (
+    <Svg size={size} className={className}>
+      <circle cx="7" cy="7" r="6" stroke={color} strokeWidth="1.5" strokeDasharray="2 1.6" opacity={0.6} />
+      {p > 0 && (
+        <circle
+          cx="7"
+          cy="7"
+          r={r / 2}
+          stroke={color}
+          strokeWidth={r}
+          strokeDasharray={`${(p * Math.PI * r).toFixed(3)} ${circumference.toFixed(3)}`}
+          transform="rotate(-90 7 7)"
+          fill="none"
+        />
+      )}
+    </Svg>
+  )
+}
+
+export function EstimateIcon({ size = 14, className, color = 'var(--text-3)' }: { size?: number; className?: string; color?: string }) {
+  return (
+    <Svg size={size} className={className}>
+      <path d="M7 1.8 12.2 11a.6.6 0 0 1-.52.9H2.32a.6.6 0 0 1-.52-.9L7 1.8Z" stroke={color} strokeWidth="1.4" strokeLinejoin="round" />
+    </Svg>
+  )
+}
+
+export function AgentGlyph({ size = 14, className, color = 'currentColor' }: { size?: number; className?: string; color?: string }) {
+  return <Bot size={size} color={color} strokeWidth={2} className={className} style={{ flex: 'none' }} aria-hidden />
+}
+
+export function TeamIcon({ color, name, size = 16 }: { color: string; name: string; size?: number }) {
+  return (
+    <span
+      aria-hidden
+      style={{
+        display: 'inline-flex',
+        alignItems: 'center',
+        justifyContent: 'center',
+        flex: 'none',
+        width: size,
+        height: size,
+        borderRadius: 4,
+        background: color,
+        color: '#fff',
+        fontSize: Math.round(size * 0.56),
+        fontWeight: 590,
+        lineHeight: 1,
+      }}
+    >
+      {name.trim().charAt(0).toUpperCase()}
+    </span>
+  )
+}
