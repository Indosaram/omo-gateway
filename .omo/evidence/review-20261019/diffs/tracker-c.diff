+        .await?;
+    record_activity(
+        &pool,
+        &issue_id,
+        Some(&me),
+        "relation_removed",
+        Some(&related),
+        None,
+    )
+    .await?;
+    Ok(StatusCode::NO_CONTENT)
+}
