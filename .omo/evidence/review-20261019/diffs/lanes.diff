+            match watcher.check_at(&HostSample::new(10.0, 50, gb, 0), now) {
+                Some(GuardReport::Alert(_)) => alerts += 1,
+                Some(GuardReport::Clear) => clears += 1,
+                None => {}
+            }
+        }
