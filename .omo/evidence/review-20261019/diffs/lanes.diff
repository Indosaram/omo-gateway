+/// Why a worktree must survive the sweep: local changes, or commits no remote has.
+async fn keep_reason(path: &str) -> Result<Option<&'static str>> {
+    if !git(path, &["status", "--porcelain"]).await?.is_empty() {
+        return Ok(Some("dirty"));
