+        "SELECT session_key FROM sessions
+         WHERE json_extract(state_json, '$.metadata.omo_thread_id') = ? AND platform <> 'lane'
+         ORDER BY thread_id IS NOT NULL DESC, updated_at DESC LIMIT 1",
+    )
+    .bind(omo_session_id.trim())
+    .fetch_optional(pool)
+    .await?)
+}
