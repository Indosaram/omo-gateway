+    if !git(path, &["remote"]).await?.is_empty()
+        && !git(path, &["log", "HEAD", "--not", "--remotes", "--oneline"])
+            .await?
+            .is_empty()
+    {
+        return Ok(Some("unpushed"));
+    }
+    Ok(None)
