+    #[test]
+    fn quiet_hours_parse_and_wrap_midnight() {
+        assert_eq!(parse_quiet_hours("0-8"), Some((0, 8)));
+        assert_eq!(parse_quiet_hours("23-7"), Some((23, 7)));
+        assert_eq!(parse_quiet_hours("off"), None);
