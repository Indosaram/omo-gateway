+# Chrome on this machine writes the screenshot and then exits 2 while its teardown watchdog
+# expires. That one exit is tolerated only with its exact stderr message; the postcondition is
+# still the artifact: the PNG this run was asked to write, written now, fully decoded by Pillow,
+# at the requested size. Every other exit code stays fatal.
+def artifact_state(path: Path) -> tuple[int, int] | None:
+    try:
+        status = path.stat()
+    except FileNotFoundError:
+        return None
+    return (status.st_size, status.st_mtime_ns)
+
+def decoded_png_size(path: Path) -> tuple[int, int] | None:
+    try:
+        with Image.open(path) as image:
+            image.verify()
+        with Image.open(path) as image:
+            image.load()
+            return image.size
+    except (UnidentifiedImageError, OSError, ValueError):
+        return None
+
+def screenshot_exit_problem(result: object) -> str | None:
+    code = getattr(result, "returncode", None)
+    if code == 0:
+        return None
+    stderr = (getattr(result, "stderr", None) or b"").decode("utf-8", "replace")
+    if code == TEARDOWN_EXIT_CODE and TEARDOWN_STDERR_MARKER in stderr:
+        return None
+    return f"Chrome exited {code} without the {TEARDOWN_STDERR_MARKER!r} teardown message"
+
+def require_screenshot(
+    output: Path,
+    width: int,
+    height: int,
+    previous: tuple[int, int] | None,
+    result: object,
+    source: Path,
+) -> None:
+    exit_code = getattr(result, "returncode", None)
+    stderr = getattr(result, "stderr", None) or b""
+    state = artifact_state(output)
+    problems: list[str] = []
+    exit_problem = screenshot_exit_problem(result)
+    if exit_problem:
+        problems.append(exit_problem)
+    if state is None:
+        problems.append(f"{output.name} was not written")
+    elif state == previous:
+        problems.append(f"{output.name} was not rewritten by this run")
+    elif state[0] == 0:
+        problems.append(f"{output.name} is empty")
+    else:
+        dimensions = decoded_png_size(output)
+        if dimensions is None:
+            problems.append(f"{output.name} is not a fully decodable PNG")
+        elif dimensions != (width, height):
+            problems.append(f"{output.name} is {dimensions[0]}x{dimensions[1]}, expected {width}x{height}")
+    if not problems:
+        return
+    message = f"Chrome produced no usable screenshot for {source.name} (exit {exit_code}): " + "; ".join(problems)
+    tail = stderr.decode("utf-8", "replace").strip().splitlines()[-3:]
+    if tail:
+        message += " | " + " / ".join(tail)
+    raise RuntimeError(message)
+
