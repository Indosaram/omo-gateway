+        with self.assertRaises(RuntimeError) as caught:
+            self.validate(ChromeResult(2, stderr=TEARDOWN_STDERR))
+
+        self.assertIn("is not a fully decodable PNG", str(caught.exception))
+
+    def test_rejects_a_screenshot_at_the_wrong_size(self) -> None:
+        write_png(self.output, RENDERER.WIDTH, 270)
+
+        with self.assertRaises(RuntimeError) as caught:
+            self.validate(ChromeResult(2, stderr=TEARDOWN_STDERR))
+
+        self.assertIn(
+            f"is {RENDERER.WIDTH}x270, expected {RENDERER.WIDTH}x{RENDERER.HEIGHT}",
+            str(caught.exception),
+        )
+
+    def test_reports_the_exit_code_and_stderr_tail_for_diagnosis(self) -> None:
+        with self.assertRaises(RuntimeError) as caught:
+            self.validate(ChromeResult(2, stderr=b"line a\nline b\n" + TEARDOWN_STDERR))
+
+        message = str(caught.exception)
+        self.assertIn("exit 2", message)
+        self.assertIn("Teardown watchdog expired", message)
