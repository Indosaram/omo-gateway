+class ChromeResult:
+    def __init__(self, returncode: int, stdout: bytes = b"", stderr: bytes = b"") -> None:
+        self.returncode = returncode
+        self.stdout = stdout
+        self.stderr = stderr
+
+
+TEARDOWN_STDERR = b"Teardown watchdog expired; recording dump and terminating."
+
+
+def write_png(path: Path, width: int, height: int) -> None:
+    Image.new("RGB", (width, height), (20, 20, 24)).save(path, format="PNG")
+
+
+class ScreenshotPostconditionTest(unittest.TestCase):
+    def setUp(self) -> None:
+        self._directory = tempfile.TemporaryDirectory()
+        self.addCleanup(self._directory.cleanup)
+        self.output = Path(self._directory.name) / "od-card-01.png"
+        self.source = Path(self._directory.name) / "card-01.html"
+
+    def validate(self, result: ChromeResult, previous: tuple[int, int] | None = None) -> None:
+        RENDERER.require_screenshot(self.output, RENDERER.WIDTH, RENDERER.HEIGHT, previous, result, self.source)
+
+    def test_accepts_a_fresh_valid_screenshot_written_before_a_teardown_exit_2(self) -> None:
+        write_png(self.output, RENDERER.WIDTH, RENDERER.HEIGHT)
+
+        self.validate(ChromeResult(2, stderr=TEARDOWN_STDERR))
+
+    def test_accepts_a_clean_exit_that_wrote_a_valid_screenshot(self) -> None:
+        write_png(self.output, RENDERER.WIDTH, RENDERER.HEIGHT)
+
+        self.validate(ChromeResult(0))
+
+    def test_rejects_a_nonzero_exit_that_is_not_the_known_teardown(self) -> None:
+        write_png(self.output, RENDERER.WIDTH, RENDERER.HEIGHT)
+
+        for exit_code in (1, 134, 139):
+            with self.subTest(exit_code=exit_code):
+                with self.assertRaises(RuntimeError) as caught:
+                    self.validate(ChromeResult(exit_code, stderr=b"Segmentation fault: 11"))
+
+                self.assertIn(f"Chrome exited {exit_code}", str(caught.exception))
+
+    def test_rejects_a_teardown_exit_code_without_its_watchdog_message(self) -> None:
+        write_png(self.output, RENDERER.WIDTH, RENDERER.HEIGHT)
+
+        with self.assertRaises(RuntimeError) as caught:
+            self.validate(ChromeResult(2, stderr=b"GPU process crashed"))
+
+        self.assertIn("Chrome exited 2", str(caught.exception))
+
+    def test_rejects_a_run_that_wrote_nothing_even_when_chrome_exits_zero(self) -> None:
+        with self.assertRaises(RuntimeError) as caught:
+            self.validate(ChromeResult(0))
+
+        self.assertIn("was not written", str(caught.exception))
+
+    def test_rejects_a_stale_screenshot_left_by_an_earlier_run(self) -> None:
+        write_png(self.output, RENDERER.WIDTH, RENDERER.HEIGHT)
+        previous = RENDERER.artifact_state(self.output)
+
+        with self.assertRaises(RuntimeError) as caught:
+            self.validate(ChromeResult(2, stderr=TEARDOWN_STDERR), previous)
+
+        self.assertIn("was not rewritten by this run", str(caught.exception))
+
+    def test_rejects_an_empty_file(self) -> None:
+        self.output.write_bytes(b"")
+
+        with self.assertRaises(RuntimeError) as caught:
+            self.validate(ChromeResult(2, stderr=TEARDOWN_STDERR))
+
+        self.assertIn("is empty", str(caught.exception))
+
+    def test_rejects_a_non_png_payload(self) -> None:
+        self.output.write_text("not a png at all, just text bytes", encoding="utf-8")
+
+        with self.assertRaises(RuntimeError) as caught:
+            self.validate(ChromeResult(2, stderr=TEARDOWN_STDERR))
+
+        self.assertIn("is not a fully decodable PNG", str(caught.exception))
+
+    def test_rejects_a_truncated_file_that_has_a_valid_png_header(self) -> None:
+        self.output.write_bytes(
+            b"\x89PNG\r\n\x1a\n" + b"\x00\x00\x00\x0d" + b"IHDR" + b"\x00\x00\x04\x38" * 2
+        )
+        self.assertEqual(24, self.output.stat().st_size)
+
+        with self.assertRaises(RuntimeError) as caught:
+            self.validate(ChromeResult(2, stderr=TEARDOWN_STDERR))
+
+        self.assertIn("is not a fully decodable PNG", str(caught.exception))
+
+    def test_rejects_a_png_truncated_after_a_partial_pixel_stream(self) -> None:
+        write_png(self.output, RENDERER.WIDTH, RENDERER.HEIGHT)
+        complete = self.output.read_bytes()
