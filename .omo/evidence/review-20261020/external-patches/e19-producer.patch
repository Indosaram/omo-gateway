+const DISCORD_CUSTOM_ID_LIMIT = 100;
+const COMPACT_VERSION = "v1";
+const COMPACT_PART_MARKER = "b64-";
+const HEX_SHA256_CHARS = 64;
+
+function compactTokenPart(part: string): string {
+  if (part.length !== HEX_SHA256_CHARS || !/^[0-9a-fA-F]+$/.test(part)) return part;
+  const bytes = Buffer.from(part, "hex");
+  if (bytes.length !== 32) return part;
+  return `${COMPACT_PART_MARKER}${bytes.toString("base64url")}`;
+}
+
+/** Wire format paired with `discordCustomId` in omon-gateway `src/discord/buttons.rs`. */
+export function discordCustomId(customId: string): string {
+  if (customId.length <= DISCORD_CUSTOM_ID_LIMIT) return customId;
+  const parts = customId.split(":");
+  if (parts.length !== 6) return customId;
+  const token = parts[5]!
+    .split(".")
+    .map(compactTokenPart)
+    .join(".");
+  return [...parts.slice(0, 5), COMPACT_VERSION, token].join(":");
+}
