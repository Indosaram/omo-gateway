+/** Mirrors the gateway's decoder in omon-gateway `src/discord/buttons.rs`. */
+function expandGatewayCustomId(customId: string): string {
+  const parts = customId.split(":");
+  if (parts.length !== 7 || parts[5] !== "v1") return customId;
+  const token = parts[6]!
+    .split(".")
+    .map((part) =>
+      part.startsWith("b64-") ? Buffer.from(part.slice(4), "base64url").toString("hex") : part,
+    )
+    .join(".");
+  return [...parts.slice(0, 5), token].join(":");
+}
