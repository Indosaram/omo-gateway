+            .collect();
+        let path = dir.join(format!(
+            "stub-cal-{safe}-{:x}",
+            std::hash::Hasher::finish(&hasher)
+        ));
+        std::fs::write(&path, script).unwrap();
+        std::fs::set_permissions(&path, std::fs::Permissions::from_mode(0o755)).unwrap();
+        path.to_string_lossy().into_owned()
+    }
