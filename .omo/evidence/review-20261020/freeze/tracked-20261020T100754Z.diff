+    /// A `group_of` lookup over `(pid, pgid)` pairs; pids absent from the map are gone.
+    fn groups(pairs: &[(i32, i32)]) -> impl Fn(i32) -> Option<i32> {
+        let map: HashMap<i32, i32> = pairs.iter().copied().collect();
+        move |pid| map.get(&pid).copied()
+    }
