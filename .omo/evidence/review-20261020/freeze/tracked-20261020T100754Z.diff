+        return custom_id.to_owned();
+    }
+    let token = parts[6]
+        .split('.')
+        .map(expand_part)
+        .collect::<Vec<_>>()
+        .join(".");
+    parts.truncate(5);
+    parts.push(token);
+    parts.join(":")
